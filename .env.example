# Copier ce fichier en .env.local puis remplir les valeurs.
# .env.local est ignoré par Git : ne jamais versionner de clé.

# URL du backend Abricot
API_URL=http://localhost:8000

# Clé de l'API Google Gemini (offre gratuite) pour la création de tâches par IA.
# Sans cette clé, l'application fonctionne mais le bouton "IA" affiche un message d'erreur.
GEMINI_API_KEY=
